# /etc/chococo/backend.env のテンプレート。実際の値を入れてサーバー上にのみ配置する（このファイルはコミットしない）。
# 各項目の意味はbackend/src/main/resources/application-prod.propertiesを参照。

SPRING_PROFILES_ACTIVE=prod

# RDSのエンドポイント（aws-infra-design.md 3.2節）
DB_URL=jdbc:mysql://<rds-endpoint>:3306/chococo?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=<rds-username>
DB_PASSWORD=<rds-password>

# auth-design.md 2章・3章
JWT_SECRET=<32バイト以上のランダム文字列>

# tech-stack.md AI API連携の節
ANTHROPIC_API_KEY=<anthropic-api-key>

# aws-infra-design.md 3.4節。deploy/nginx/chococo.confの /uploads/ alias先と一致させること
UPLOAD_DIR=/var/chococo/uploads
